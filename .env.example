# Copy to .env (or set in your hosting dashboard)
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql://user:password@host:5432/zawadeefarm
SESSION_COOKIE_SECURE=1
# First administrator, created automatically on first start if missing
ADMIN_EMAIL=owner@zawadeefarm.co.ke
ADMIN_NAME=Farm Owner
ADMIN_PASSWORD=choose-a-strong-password
